#!/usr/bin/env bash

case "${1}" in
    get)
        read REGISTRY
        case "${REGISTRY}" in
            ("registry-c.com"|"https://registry-c.com") echo "{\"ServerURL\":\"https://registry-c.com\",\"Username\":\"foo\",\"Secret\":\"bar\"}" ;;
            ("index.docker.io"|"https://index.docker.io/v1/") echo "{\"ServerURL\":\"https://index.docker.io/v1/\",\"Username\":\"hub\",\"Secret\":\"hubpass\"}" ;;
            ("registry-d.com") echo "{\"ServerURL\":\"registry-d.com\",\"Username\":\"team\",\"Secret\":\"teampass\"}" ;;
            (*) echo "credentials not found in native keychain" && exit 1 ;;
        esac
        exit 0
    ;;
    list)
        read UNUSED
        echo "{\"https://registry-c.com\":\"foo\",\"https://index.docker.io/v1/\":\"hub\",\"registry-d.com/team\":\"team\"}"
        exit 0
    ;;
    *)
        echo "not implemented"
        exit 1
    ;;
esac
